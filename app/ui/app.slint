import { LineEdit, TextEdit, ComboBox, ScrollView, CheckBox, Palette } from "std-widgets.slint";

// ---- theme -----------------------------------------------------------------

export { Palette }

export global Theme {
    in-out property <bool> dark: false;
    out property <color> bg: dark ? #14151d : #f5f6fa;
    out property <color> surface: dark ? #1c1e2c : #ffffff;
    out property <color> surface-2: dark ? #24263a : #fafbfd;
    out property <color> border: dark ? #2e3147 : #e3e5ee;
    out property <color> text: dark ? #eceef7 : #1d1f2b;
    out property <color> body: dark ? #c5c8dc : #3f4259;
    out property <color> muted: dark ? #9a9db5 : #6b6f86;
    out property <color> faint: dark ? #7b7f98 : #8b8fa6;
    out property <color> hover: dark ? #2a2d45 : #eeedf9;
    out property <color> accent: #6e56cf;
    out property <color> accent-hover: #5d46bb;
    out property <color> accent-ink: #ffffff;
    out property <color> pill-bg: dark ? #2b2a47 : #ebe9f8;
    out property <color> pill-ink: dark ? #c9c4ff : #3d3689;
    out property <color> sidebar: dark ? #0d0e15 : #1b1d29;
    out property <color> sidebar-active: #2f3150;
    out property <color> warn: #c2552d;
}

// ---- data passed from Rust -------------------------------------------------

export struct TaskItem {
    id: string,
    title: string,
    description: string,
    kind: string,
    kind-label: string,
    priority: string,
    status: string,
    status-label: string,
    due: string,
    due-label: string,
    overdue: bool,
    subtasks-done: int,
    subtasks-total: int,
    updated-label: string,
    parent-id: string,
}

export struct SubtaskItem {
    index: int,
    title: string,
    done: bool,
    child: bool,
    child-status: string,
}

export struct ColumnItem {
    status: string,
    label: string,
    count: int,
    tasks: [TaskItem],
}

export struct RunItem {
    id: string,
    skill-label: string,
    status: string,
    status-label: string,
    created-label: string,
    result: string,
    pending: bool,
}

export struct SkillItem {
    name: string,
    label: string,
    description: string,
    arg-name: string,
    arg-hint: string,
    arg-required: bool,
    value: string,
}

export struct PaletteItem {
    label: string,
    hint: string,
}

// ---- building blocks -------------------------------------------------------

// One button style for the whole app. Fixed height, so it never stretches inside a row.
component AppButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> ghost: false;
    in property <bool> small: false;
    in property <bool> on-dark: false;
    callback clicked();
    height: root.small ? 28px : 34px;
    min-width: label.preferred-width + (root.small ? 22px : 32px);
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 8px;
    background: root.primary
        ? (ta.has-hover ? Theme.accent-hover : Theme.accent)
        : root.ghost
            ? (ta.has-hover ? Theme.hover : transparent)
            : (ta.has-hover ? Theme.hover : Theme.surface);
    border-width: root.primary || root.ghost ? 0px : 1px;
    border-color: root.on-dark ? #ffffff26 : Theme.border;
    label := Text {
        x: 0px;
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.primary ? Theme.accent-ink : (root.on-dark ? #d8dae9 : Theme.body);
        font-size: root.small ? 12px : 13px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component Pill inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.pill-bg;
    in property <color> ink: Theme.pill-ink;
    background: tint;
    border-radius: 9px;
    height: 20px;
    horizontal-stretch: 0;
    width: label.preferred-width + 16px;
    label := Text {
        text: root.text;
        color: root.ink;
        font-size: 11px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component NavButton inherits Rectangle {
    in property <string> text;
    in property <string> count;
    in property <bool> active;
    callback clicked();
    height: 36px;
    border-radius: 8px;
    background: root.active ? Theme.sidebar-active : (ta.has-hover ? #ffffff14 : transparent);
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 8px;
                Text {
            text: root.text;
            color: root.active ? #ffffff : #c9cbe0;
            font-size: 13px;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: root.count;
            color: #9fa2c4;
            font-size: 12px;
            vertical-alignment: center;
            visible: root.count != "";
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component StatCard inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> sub;
    in property <bool> warn;
    background: Theme.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border;
    height: 92px;
    VerticalLayout {
        padding: 14px;
        spacing: 2px;
        alignment: start;
        Text { text: root.label; color: Theme.muted; font-size: 12px; vertical-stretch: 0; }
        Text { text: root.value; color: Theme.text; font-size: 26px; font-weight: 700; vertical-stretch: 0; }
        Text {
            text: root.sub;
            color: root.warn ? Theme.warn : Theme.faint;
            font-size: 11px;
            overflow: elide;
            vertical-stretch: 0;
        }
    }
}

component TaskCard inherits Rectangle {
    in property <TaskItem> task;
    callback clicked();
    background: Theme.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        padding: 14px;
        spacing: 6px;
        alignment: start;
        HorizontalLayout {
            spacing: 6px;
            Pill {
                text: root.task.kind-label;
                tint: root.task.kind == "bug" ? #fde4e1 : (root.task.kind == "epic" ? #e4ecfd : Theme.pill-bg);
                ink: root.task.kind == "bug" ? #a33b26 : (root.task.kind == "epic" ? #2c4f9e : Theme.pill-ink);
            }
            Rectangle { horizontal-stretch: 1; }
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                y: 6px;
                background: root.task.priority == "high" ? #e0523c : (root.task.priority == "medium" ? #e8a33a : #9aa0b8);
            }
        }
        Text {
            text: root.task.title;
            color: Theme.text;
            font-size: 14px;
            font-weight: 600;
            wrap: word-wrap;
            overflow: elide;
            vertical-stretch: 0;
        }
        if root.task.description != "" : Text {
            text: root.task.description;
            color: Theme.muted;
            font-size: 12px;
            wrap: word-wrap;
            overflow: elide;
            max-height: 34px;
            vertical-stretch: 0;
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            Text { text: root.task.id; color: Theme.faint; font-size: 11px; font-family: "DM Mono"; horizontal-stretch: 1; }
            Text {
                text: root.task.subtasks-total > 0
                    ? root.task.subtasks-done + "/" + root.task.subtasks-total + " subtasks  ·  " + root.task.due-label
                    : root.task.due-label;
                color: root.task.overdue ? Theme.warn : Theme.faint;
                font-size: 11px;
            }
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component Overlay inherits Rectangle {
    in property <bool> open;
    callback dismissed();
    background: #0b0c1480;
    visible: root.open;
    TouchArea { clicked => { root.dismissed(); } }
}

component Dialog inherits Rectangle {
    background: Theme.surface;
    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 30px;
    drop-shadow-color: #00000050;
}

component ColumnHeader inherits Rectangle {
    in property <string> label;
    in property <int> count;
    callback add();
    height: 34px;
    HorizontalLayout {
        spacing: 8px;
                Text { text: root.label; color: Theme.text; font-size: 14px; font-weight: 600; vertical-alignment: center; }
        Pill { text: root.count; }
        Rectangle { horizontal-stretch: 1; }
        AppButton { text: "+ New"; small: true; ghost: true; clicked => { root.add(); } }
    }
}

// ---- main window -----------------------------------------------------------

export component AppWindow inherits Window {
    title: "Clankban";
    preferred-width: 1440px;
    preferred-height: 960px;
    min-width: 980px;
    min-height: 680px;
    background: Theme.bg;

    // view state
    in-out property <string> view: "board";
    in-out property <string> search: "";
    in-out property <string> sort: "Priority";
    in-out property <bool> filter-open: false;
    in-out property <string> filter-priority: "";
    in-out property <string> filter-type: "";
    in-out property <string> filter-status: "";
    in-out property <int> filter-count: 0;

    // stats
    in-out property <string> stat-active: "0";
    in-out property <string> stat-active-sub: "";
    in-out property <string> stat-due: "0";
    in-out property <string> stat-due-sub: "";
    in-out property <bool> stat-due-warn: false;
    in-out property <string> stat-done: "0";
    in-out property <string> stat-done-sub: "";
    in-out property <string> stat-recent: "0";
    in-out property <string> stat-recent-sub: "";
    in-out property <string> nav-board-count: "0";
    in-out property <string> nav-recent-count: "0";
    in-out property <string> nav-agent-count: "0";

    // data
    in-out property <[ColumnItem]> columns;
    in-out property <[TaskItem]> list-tasks;
    in-out property <[TaskItem]> recent-tasks;
    in-out property <[RunItem]> runs;
    in-out property <[SkillItem]> skills;
    in-out property <string> run-count-label: "";

    // sync and updates
    in-out property <string> sync-text: "Starting…";
    in-out property <string> sync-detail: "";
    in-out property <bool> sync-ok: true;
    in-out property <string> version-text: "";
    in-out property <string> update-text: "";
    in-out property <bool> update-available: false;
    in-out property <string> install-label: "";
    in-out property <string> notice: "";
    in-out property <string> theme-button: "Dark mode";

    // drawer
    in-out property <bool> drawer-open: false;
    in-out property <TaskItem> drawer-task;
    in-out property <[SubtaskItem]> drawer-subtasks;
    in-out property <string> drawer-updated: "";
    in-out property <string> drawer-status-label: "";

    // form
    in-out property <bool> form-open: false;
    in-out property <string> form-heading: "Create a task";
    in-out property <string> form-title: "";
    in-out property <string> form-description: "";
    in-out property <string> form-type: "task";
    in-out property <string> form-priority: "medium";
    in-out property <string> form-status: "backlog";
    in-out property <string> form-due: "";
    in-out property <bool> form-is-new: true;

    // overlays
    in-out property <bool> palette-open: false;
    in-out property <string> palette-query: "";
    in-out property <[PaletteItem]> palette-items;
    in-out property <bool> help-open: false;
    in-out property <bool> json-open: false;
    in-out property <string> json-text: "";
    in-out property <bool> confirm-open: false;
    in-out property <string> confirm-text: "";
    in-out property <string> confirm-action: "";

    // callbacks into Rust
    callback set-view(string);
    callback search-changed(string);
    callback sort-changed(string);
    callback filter-changed(string, string, string);
    callback filter-cleared();
    callback refresh();
    callback new-task(string);
    callback open-task(string);
    callback edit-task();
    callback delete-task();
    callback toggle-subtask(int, bool);
    callback save-form();
    callback palette-query-changed(string);
    callback palette-run(int);
    callback show-json();
    callback copy-json();
    callback send-run(int);
    callback skill-edited(int, string);
    callback cancel-run(string);
    callback check-updates();
    callback install-update();
    callback confirm-accepted(string);
    callback show-only-status(string);
    callback toggle-theme();

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control && event.text == "k") {
                root.palette-query = "";
                root.palette-query-changed("");
                root.palette-open = true;
                return accept;
            }
            if (event.text == Key.Escape) {
                root.palette-open = false;
                root.help-open = false;
                root.json-open = false;
                root.confirm-open = false;
                root.form-open = false;
                root.drawer-open = false;
                root.filter-open = false;
                return accept;
            }
            if (root.form-open || root.palette-open || root.confirm-open) {
                return reject;
            }
            if (event.text == "/") {
                search-input.focus();
                return accept;
            }
            if (event.text == "n" || event.text == "N") {
                root.new-task("");
                return accept;
            }
            if (event.text == "?") {
                root.help-open = true;
                return accept;
            }
            if (event.text == Key.F5) {
                root.refresh();
                return accept;
            }
            reject
        }
    }

    HorizontalLayout {
        // ---- sidebar ----
        Rectangle {
            width: 232px;
            background: Theme.sidebar;
            VerticalLayout {
                padding: 18px;
                padding-top: 20px;
                spacing: 4px;
                HorizontalLayout {
                    spacing: 10px;
                    padding-bottom: 14px;
                    Rectangle {
                        width: 30px; height: 30px; border-radius: 9px; background: Theme.accent;
                        Text { text: "C"; color: white; font-size: 16px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    VerticalLayout {
                        alignment: center;
                        Text { text: "Clankban"; color: #ffffff; font-size: 15px; font-weight: 600; }
                        Text { text: "Atlas workspace"; color: #8d91b0; font-size: 11px; }
                    }
                }
                Text { text: "VIEWS"; color: #6f7394; font-size: 10px; font-weight: 700; padding-bottom: 4px; }
                NavButton { text: "Board"; count: root.nav-board-count; active: root.view == "board"; clicked => { root.set-view("board"); } }
                NavButton { text: "List"; count: ""; active: root.view == "list"; clicked => { root.set-view("list"); } }
                NavButton { text: "Recent changes"; count: root.nav-recent-count; active: root.view == "recent"; clicked => { root.set-view("recent"); } }
                NavButton { text: "Agent runs"; count: root.nav-agent-count; active: root.view == "agent"; clicked => { root.set-view("agent"); } }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 8px;
                    padding-bottom: 10px;
                    Rectangle { width: 8px; height: 8px; border-radius: 4px; y: 6px; background: root.sync-ok ? #4cc38a : #e0523c; }
                    VerticalLayout {
                        Text { text: root.sync-text; color: #ffffff; font-size: 12px; font-weight: 600; }
                        Text { text: root.sync-detail; color: #8d91b0; font-size: 11px; wrap: word-wrap; }
                    }
                }
                AppButton { text: root.theme-button; small: true; ghost: true; on-dark: true; horizontal-stretch: 1; clicked => { root.toggle-theme(); } }
                Rectangle { height: 6px; }
                Text { text: "Version " + root.version-text; color: #8d91b0; font-size: 11px; }
                Text { text: root.update-text; color: #c9cbe0; font-size: 11px; wrap: word-wrap; visible: root.update-text != ""; }
                HorizontalLayout {
                    spacing: 6px;
                    AppButton { text: "Check for updates"; small: true; ghost: true; on-dark: true; horizontal-stretch: 1; clicked => { root.check-updates(); } }
                    AppButton { text: root.install-label; small: true; primary: true; visible: root.update-available; clicked => { root.install-update(); } }
                }
            }
        }

        // ---- main area ----
        VerticalLayout {
            // header
            Rectangle {
                height: 72px;
                background: Theme.bg;
                HorizontalLayout {
                    padding-left: 28px;
                    padding-right: 28px;
                    spacing: 10px;
                                        VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "LOCAL PROJECT";
                            color: Theme.accent;
                            font-size: 10px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.view == "board" ? "Product board" : (root.view == "list" ? "All tasks" : (root.view == "recent" ? "Recent changes" : "Agent runs"));
                            color: Theme.text;
                            font-size: 22px;
                            font-weight: 700;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    AppButton { text: "Refresh"; small: true; ghost: true; clicked => { root.refresh(); } }
                    AppButton { text: "Copy agent JSON"; clicked => { root.show-json(); } }
                    AppButton { text: "Command menu  ⌘K"; clicked => { root.palette-query = ""; root.palette-query-changed(""); root.palette-open = true; } }
                    AppButton { text: "New task"; primary: true; clicked => { root.new-task(""); } }
                }
            }

            // stats
            HorizontalLayout {
                padding-left: 28px;
                padding-right: 28px;
                padding-bottom: 18px;
                spacing: 14px;
                StatCard { horizontal-stretch: 1; label: "Active work"; value: root.stat-active; sub: root.stat-active-sub; }
                StatCard { horizontal-stretch: 1; label: "Due in 7 days"; value: root.stat-due; sub: root.stat-due-sub; warn: root.stat-due-warn; }
                StatCard { horizontal-stretch: 1; label: "Completed"; value: root.stat-done; sub: root.stat-done-sub; }
                StatCard { horizontal-stretch: 1; label: "Changed in 24h"; value: root.stat-recent; sub: root.stat-recent-sub; }
            }

            // toolbar
            HorizontalLayout {
                padding-left: 28px;
                padding-right: 28px;
                padding-bottom: 14px;
                spacing: 10px;
                search-input := LineEdit {
                    width: 300px;
                    height: 34px;
                    placeholder-text: "Search tasks  ( / )";
                    text: root.search;
                    edited(text) => { root.search = text; root.search-changed(text); }
                }
                AppButton {
                    text: root.filter-count > 0 ? "Filters  " + root.filter-count : "Filters";
                    ghost: root.filter-count == 0;
                    primary: root.filter-count > 0;
                    clicked => { root.filter-open = !root.filter-open; }
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: root.view == "board" ? root.nav-board-count + " tasks" : "";
                    color: Theme.faint;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                ComboBox {
                    width: 150px;
                    model: ["Sort: Priority", "Sort: Newest", "Sort: Due date"];
                    current-value: "Sort: " + root.sort;
                    selected(value) => {
                        root.sort = value == "Sort: Newest" ? "Newest" : (value == "Sort: Due date" ? "Due date" : "Priority");
                        root.sort-changed(root.sort);
                    }
                }
            }

            // filter panel
            if root.filter-open : Rectangle {
                background: Theme.surface;
                border-radius: 12px;
                border-width: 1px;
                border-color: Theme.border;
                height: 78px;
                HorizontalLayout {
                    padding: 14px;
                    padding-left: 18px;
                    spacing: 14px;
                    alignment: start;
                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "Priority"; color: Theme.muted; font-size: 11px; }
                        ComboBox {
                            width: 150px;
                            model: ["Any", "high", "medium", "low"];
                            current-value: root.filter-priority == "" ? "Any" : root.filter-priority;
                            selected(value) => { root.filter-priority = value == "Any" ? "" : value; root.filter-changed(root.filter-priority, root.filter-type, root.filter-status); }
                        }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "Type"; color: Theme.muted; font-size: 11px; }
                        ComboBox {
                            width: 150px;
                            model: ["Any", "epic", "task", "subtask", "bug"];
                            current-value: root.filter-type == "" ? "Any" : root.filter-type;
                            selected(value) => { root.filter-type = value == "Any" ? "" : value; root.filter-changed(root.filter-priority, root.filter-type, root.filter-status); }
                        }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "Status"; color: Theme.muted; font-size: 11px; }
                        ComboBox {
                            width: 150px;
                            model: ["Any", "backlog", "progress", "review", "done"];
                            current-value: root.filter-status == "" ? "Any" : root.filter-status;
                            selected(value) => { root.filter-status = value == "Any" ? "" : value; root.filter-changed(root.filter-priority, root.filter-type, root.filter-status); }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    VerticalLayout {
                        alignment: end;
                        AppButton { text: "Clear filters"; ghost: true; clicked => { root.filter-cleared(); } }
                    }
                }
            }

            // content
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    padding-left: 28px;
                    padding-right: 28px;
                    padding-bottom: 24px;
                    spacing: 16px;

                    // board view
                    if root.view == "board" : HorizontalLayout {
                        spacing: 14px;
                        alignment: start;
                        for column[ci] in root.columns : VerticalLayout {
                            horizontal-stretch: 1;
                            min-width: 200px;
                            spacing: 10px;
                            alignment: start;
                            ColumnHeader { label: column.label; count: column.count; add => { root.new-task(column.status); } }
                            for task[ti] in column.tasks : TaskCard {
                                task: task;
                                clicked => { root.open-task(task.id); }
                            }
                            if column.count == 0 : Rectangle {
                                height: 64px;
                                border-radius: 12px;
                                border-width: 1px;
                                border-color: Theme.border;
                                Text { text: "Nothing here"; color: Theme.faint; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }

                    // list view
                    if root.view == "list" : Rectangle {
                        vertical-stretch: 0;
                        background: Theme.surface;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: 8px;
                            spacing: 0px;
                            alignment: start;
                            HorizontalLayout {
                                padding: 10px;
                                padding-left: 14px;
                                Text { text: "ID"; width: 90px; color: Theme.muted; font-size: 11px; font-weight: 600; }
                                Text { text: "Title"; horizontal-stretch: 1; color: Theme.muted; font-size: 11px; font-weight: 600; }
                                Text { text: "Type"; width: 110px; color: Theme.muted; font-size: 11px; font-weight: 600; }
                                Text { text: "Priority"; width: 90px; color: Theme.muted; font-size: 11px; font-weight: 600; }
                                Text { text: "Status"; width: 110px; color: Theme.muted; font-size: 11px; font-weight: 600; }
                                Text { text: "Due"; width: 110px; color: Theme.muted; font-size: 11px; font-weight: 600; }
                            }
                            for task[i] in root.list-tasks : Rectangle {
                                height: 40px;
                                background: ra.has-hover ? Theme.hover : transparent;
                                HorizontalLayout {
                                    padding: 10px;
                                    padding-left: 14px;
                                    Text { text: task.id; width: 90px; color: Theme.muted; font-size: 12px; font-family: "DM Mono"; vertical-alignment: center; }
                                    Text { text: task.title; horizontal-stretch: 1; color: Theme.text; font-size: 13px; overflow: elide; vertical-alignment: center; }
                                    Text { text: task.kind-label; width: 110px; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                                    Text { text: task.priority; width: 90px; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                                    Text { text: task.status-label; width: 110px; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                                    Text { text: task.due-label; width: 110px; color: task.overdue ? Theme.warn : Theme.muted; font-size: 12px; vertical-alignment: center; }
                                }
                                ra := TouchArea { clicked => { root.open-task(task.id); } }
                            }
                            if root.list-tasks.length == 0 : Text { text: "No tasks match these filters."; color: Theme.faint; font-size: 13px; padding: 14px; }
                        }
                    }

                    // recent view
                    if root.view == "recent" : Rectangle {
                        vertical-stretch: 0;
                        background: Theme.surface;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: 8px;
                            spacing: 0px;
                            alignment: start;
                            for task[i] in root.recent-tasks : Rectangle {
                                height: 44px;
                                background: rr.has-hover ? Theme.hover : transparent;
                                HorizontalLayout {
                                    padding: 10px;
                                    padding-left: 14px;
                                    spacing: 12px;
                                    Text { text: task.id; width: 90px; color: Theme.muted; font-size: 12px; font-family: "DM Mono"; vertical-alignment: center; }
                                    Text { text: task.title; horizontal-stretch: 1; color: Theme.text; font-size: 13px; overflow: elide; vertical-alignment: center; }
                                    Text { text: task.status-label; width: 110px; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                                    Text { text: task.updated-label; width: 110px; color: Theme.faint; font-size: 12px; vertical-alignment: center; }
                                }
                                rr := TouchArea { clicked => { root.open-task(task.id); } }
                            }
                            if root.recent-tasks.length == 0 : Text { text: "No changes recorded yet. Edits made from the board or an agent appear here."; color: Theme.faint; font-size: 13px; padding: 14px; }
                        }
                    }

                    // agent runs view
                    if root.view == "agent" : VerticalLayout {
                        spacing: 16px;
                        alignment: start;
                        Text {
                            text: "Send a skill to the connected agent. It reads the request through the MCP bridge, shows its plan, and waits for your approval before changing anything.";
                            color: Theme.muted; font-size: 13px; wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 14px;
                            vertical-stretch: 0;
                            alignment: start;
                            for skill[si] in root.skills : Rectangle {
                                horizontal-stretch: 1;
                                vertical-stretch: 0;
                                background: Theme.surface;
                                border-radius: 12px;
                                border-width: 1px;
                                border-color: Theme.border;
                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 8px;
                                    alignment: start;
                                    Text { text: skill.label; color: Theme.text; font-size: 15px; font-weight: 600; vertical-stretch: 0; }
                                    Text { text: skill.description; color: Theme.muted; font-size: 12px; wrap: word-wrap; vertical-stretch: 0; min-height: 56px; }
                                    Text { text: skill.arg-name + (skill.arg-required ? " · required" : " · optional"); color: Theme.faint; font-size: 11px; vertical-stretch: 0; }
                                    TextEdit {
                                        height: 96px;
                                        vertical-stretch: 0;
                                        placeholder-text: skill.arg-hint;
                                        text: skill.value;
                                        edited(text) => { root.skill-edited(si, text); }
                                    }
                                    AppButton { text: "Send to agent"; primary: true; clicked => { root.send-run(si); } }
                                }
                            }
                        }
                        HorizontalLayout {
                            Text { text: "Requests"; color: Theme.text; font-size: 15px; font-weight: 600; horizontal-stretch: 1; }
                            Text { text: root.run-count-label; color: Theme.faint; font-size: 12px; }
                        }
                        for run[ri] in root.runs : Rectangle {
                            background: Theme.surface;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 6px;
                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "#" + run.id + "  " + run.skill-label; color: Theme.text; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                                    Pill { text: run.status-label; }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text { text: run.created-label; color: Theme.faint; font-size: 11px; vertical-alignment: center; }
                                    if run.pending : AppButton { text: "Cancel"; small: true; ghost: true; clicked => { root.cancel-run(run.id); } }
                                }
                                if run.result != "" : Text { text: run.result; color: Theme.body; font-size: 12px; wrap: word-wrap; }
                            }
                        }
                        if root.runs.length == 0 : Text { text: "No requests yet. Send a skill above."; color: Theme.faint; font-size: 13px; }
                    }
                }
            }

            // footer
            Rectangle {
                height: 32px;
                background: Theme.bg;
                HorizontalLayout {
                    padding-left: 28px;
                    padding-right: 28px;
                    Text { text: root.notice; color: Theme.warn; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    Text { text: "Ctrl+K commands  ·  ?  shortcuts  ·  stored locally"; color: Theme.faint; font-size: 11px; vertical-alignment: center; }
                }
            }
        }
    }

    // ---- drawer ----
    if root.drawer-open : Rectangle {
        x: root.width - self.width;
        y: 0px;
        width: 400px;
        height: root.height;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000030;
        VerticalLayout {
            padding: 22px;
            spacing: 12px;
            HorizontalLayout {
                Pill { text: root.drawer-task.kind-label; }
                Rectangle { horizontal-stretch: 1; }
                AppButton { text: "Close"; small: true; ghost: true; clicked => { root.drawer-open = false; } }
            }
            Text { text: root.drawer-task.id; color: Theme.faint; font-size: 12px; font-family: "DM Mono"; }
            Text { text: root.drawer-task.title; color: Theme.text; font-size: 20px; font-weight: 700; wrap: word-wrap; }
            Text { text: root.drawer-task.description != "" ? root.drawer-task.description : "No description yet."; color: Theme.body; font-size: 13px; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 6px;
                Pill { text: root.drawer-task.priority + " priority"; }
                Pill { text: root.drawer-status-label; }
                Pill { text: "Due " + root.drawer-task.due-label; }
            }
            Text { text: "Subtasks  " + root.drawer-task.subtasks-done + " / " + root.drawer-task.subtasks-total; color: Theme.text; font-size: 13px; font-weight: 600; }
            for sub[i] in root.drawer-subtasks : HorizontalLayout {
                spacing: 8px;
                if !sub.child : CheckBox {
                    text: sub.title;
                    checked: sub.done;
                    toggled => { root.toggle-subtask(sub.index, self.checked); }
                }
                if sub.child : Text { text: "· " + sub.title + "  (" + sub.child-status + ")"; color: Theme.body; font-size: 13px; }
            }
            Text { text: "Last change: " + root.drawer-updated; color: Theme.faint; font-size: 12px; }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 8px;
                AppButton { text: "Delete"; ghost: true; clicked => { root.confirm-text = "Delete this work item? This cannot be undone."; root.confirm-action = "delete"; root.confirm-open = true; } }
                Rectangle { horizontal-stretch: 1; }
                AppButton { text: "Edit task"; primary: true; clicked => { root.edit-task(); } }
            }
        }
    }

    // ---- create / edit form ----
    Overlay { open: root.form-open; dismissed => { root.form-open = false; } }
    if root.form-open : Dialog {
        width: 600px;
        height: 580px;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        VerticalLayout {
            padding: 24px;
            spacing: 12px;
            Text { text: root.form-heading; color: Theme.text; font-size: 18px; font-weight: 700; }
            Text { text: "Title"; color: Theme.muted; font-size: 12px; }
            LineEdit { height: 34px; placeholder-text: "What needs to happen?"; text <=> root.form-title; }
            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    Text { text: "Type"; color: Theme.muted; font-size: 12px; }
                    ComboBox { model: ["task", "epic", "bug", "subtask"]; current-value: root.form-type; selected(value) => { root.form-type = value; } }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    Text { text: "Priority"; color: Theme.muted; font-size: 12px; }
                    ComboBox { model: ["high", "medium", "low"]; current-value: root.form-priority; selected(value) => { root.form-priority = value; } }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    Text { text: "Status"; color: Theme.muted; font-size: 12px; }
                    ComboBox { model: ["backlog", "progress", "review", "done"]; current-value: root.form-status; selected(value) => { root.form-status = value; } }
                }
            }
            Text { text: "Due date"; color: Theme.muted; font-size: 12px; }
            LineEdit { height: 34px; placeholder-text: "YYYY-MM-DD (optional)"; text <=> root.form-due; }
            Text { text: "Description"; color: Theme.muted; font-size: 12px; }
            TextEdit { height: 140px; placeholder-text: "Add context for teammates and agents…"; text <=> root.form-description; }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 8px;
                Rectangle { horizontal-stretch: 1; }
                AppButton { text: "Cancel"; ghost: true; clicked => { root.form-open = false; } }
                AppButton { text: "Save"; primary: true; clicked => { root.save-form(); } }
            }
        }
    }

    // ---- command palette ----
    if root.palette-open : Dialog {
        width: 580px;
        height: min(root.height * 0.6, 440px);
        x: (root.width - self.width) / 2;
        y: 100px;
        VerticalLayout {
            padding: 12px;
            spacing: 8px;
            palette-input := LineEdit {
                height: 40px;
                placeholder-text: "Type a command…";
                text: root.palette-query;
                edited(text) => { root.palette-query = text; root.palette-query-changed(text); }
                accepted => { root.palette-run(0); }
            }
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    for item[pi] in root.palette-items : Rectangle {
                        height: 38px;
                        border-radius: 8px;
                        background: pa.has-hover ? Theme.hover : transparent;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            Text { text: item.label; color: Theme.text; font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; }
                            Text { text: item.hint; color: Theme.faint; font-size: 12px; vertical-alignment: center; }
                        }
                        pa := TouchArea { clicked => { root.palette-run(pi); } }
                    }
                }
            }
        }
    }

    // ---- shortcuts ----
    if root.help-open : Dialog {
        width: 460px;
        height: 330px;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        VerticalLayout {
            padding: 24px;
            spacing: 10px;
            Text { text: "Keyboard shortcuts"; color: Theme.text; font-size: 18px; font-weight: 700; }
            Text { text: "Ctrl + K   command menu"; color: Theme.body; font-size: 13px; }
            Text { text: "/            search tasks"; color: Theme.body; font-size: 13px; }
            Text { text: "N            new task"; color: Theme.body; font-size: 13px; }
            Text { text: "F5           refresh"; color: Theme.body; font-size: 13px; }
            Text { text: "Esc          close the open panel"; color: Theme.body; font-size: 13px; }
            Text { text: "?            this list"; color: Theme.body; font-size: 13px; }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout { Rectangle { horizontal-stretch: 1; } AppButton { text: "Close"; clicked => { root.help-open = false; } } }
        }
    }

    // ---- agent JSON ----
    if root.json-open : Dialog {
        width: 680px;
        height: 540px;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        VerticalLayout {
            padding: 24px;
            spacing: 10px;
            Text { text: "Board state as JSON"; color: Theme.text; font-size: 18px; font-weight: 700; }
            Text { text: "The same representation agents read through the MCP bridge."; color: Theme.muted; font-size: 12px; }
            ScrollView {
                vertical-stretch: 1;
                Text { text: root.json-text; color: Theme.text; font-size: 11px; font-family: "DM Mono"; wrap: word-wrap; }
            }
            HorizontalLayout {
                spacing: 8px;
                Rectangle { horizontal-stretch: 1; }
                AppButton { text: "Copy JSON"; primary: true; clicked => { root.copy-json(); } }
                AppButton { text: "Close"; ghost: true; clicked => { root.json-open = false; } }
            }
        }
    }

    // ---- confirm ----
    if root.confirm-open : Dialog {
        width: 400px;
        height: 180px;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        VerticalLayout {
            padding: 24px;
            spacing: 14px;
            Text { text: root.confirm-text; color: Theme.text; font-size: 14px; wrap: word-wrap; }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 8px;
                Rectangle { horizontal-stretch: 1; }
                AppButton { text: "Cancel"; ghost: true; clicked => { root.confirm-open = false; } }
                AppButton {
                    text: "Yes";
                    primary: true;
                    clicked => { root.confirm-open = false; root.confirm-accepted(root.confirm-action); }
                }
            }
        }
    }
}
