{
  "name": "clankban",
  "version": "0.1.0",
  "description": "A local-first visual workspace for humans and coding agents.",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "api": "node server.js",
    "mcp": "node mcp-server.js",
    "package:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^39.2.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.clankban.desktop",
    "productName": "Clankban",
    "files": ["ui/**/*", "main.js", "preload.js", "server.js", "mcp-server.js", "package.json"],
    "win": {"target": "nsis", "artifactName": "Clankban-Setup-${version}.${ext}"},
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true}
  }
}
